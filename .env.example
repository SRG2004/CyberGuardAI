# ============================================================
# CyberGuard AI — Environment Variables
# ============================================================
# Copy to .env and fill in your values:
#   cp .env.example .env

# ─── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ──────────────────────────────────────────
# Local: mongodb://127.0.0.1:27017/cyberguard
# Atlas: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/cyberguard
MONGODB_URI=mongodb://127.0.0.1:27017/cyberguard

# ─── JWT (generate strong secrets for production!) ────
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-this-to-another-random-64-char-string
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ─── ML Service ──────────────────────────────────────
# Local: http://localhost:8001
# Production: https://cyberguard-ml.onrender.com
ML_SERVICE_URL=http://localhost:8001

# ─── Frontend URL (for CORS) ─────────────────────────
# Local: http://localhost:5173
# Production: https://your-app.vercel.app
# Multiple origins: https://app.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ─── External APIs (optional) ────────────────────────
GOOGLE_SAFE_BROWSING_KEY=your_key_here
VIRUSTOTAL_API_KEY=your_key_here
WHOIS_API_KEY=your_key_here

# ─── Email (optional — for password reset) ───────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_app_password

# ─── Cloudinary (optional — for file uploads) ────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret

# ─── Extension ───────────────────────────────────────
EXTENSION_API_SECRET=cyberguard-extension-secret

# ─── PhishTank ────────────────────────────────────────
PHISHTANK_API_URL=https://data.phishtank.com/data/online-valid.csv
