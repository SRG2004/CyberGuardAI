# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/cyberguard?retryWrites=true&w=majority

# JWT
JWT_SECRET=change-this-to-a-random-256-bit-secret-in-production
JWT_REFRESH_SECRET=change-this-to-another-random-secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# External APIs
GOOGLE_SAFE_BROWSING_KEY=
VIRUSTOTAL_API_KEY=
WHOIS_API_KEY=
PHISHTANK_APP_NAME=

# ML Service
ML_SERVICE_URL=http://localhost:8001

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@cyberguard.io
SMTP_PASS=

# File Uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Extension
EXTENSION_ORIGIN=chrome-extension://*
